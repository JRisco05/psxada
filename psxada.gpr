with "config/psxada_config.gpr";

project Psxada is

   -- 🌟 OBLIGATORIO: Activar soporte para ambos lenguajes al inicio del proyecto
   for Languages use ("Ada", "C"); 

   for Source_Dirs use
     ("src/psx/",
      "src/types/",
      "src/psxada/",
      "src/cpu/",
      "src/cpu/register/",
      "src/cpu/cycles/",
      "src/cpu/muldiv/",
      "src/cpu/instruction/",
      "src/cpu/execute/",
      "src/cpu/fetch",
      "src/cpu/muldiv",
      "src/cpu/step",
      "src/gpu/",
      "src/display/",
      "src/gte/",
      "src/sio/",
      "src/cdrom/",
      "src/gte/instruction/",
      "src/gte/execute/",
      "src/spu/",
      "src/memory/",
      "src/state/",
      "src/dma/",
      "src/timers/",
      "bios/",
      "tests/cpu/execute",
      "tests/cpu/register",
      "tests/cpu/muldiv",
      "tests/cpu/step",
      "tests/memory/",
      "tests/bios/",
      "tests/spu/",
      "tests/timers/",
      "tests/gpu/",
      "tests/gte/",
      "tests/gte/conformance",
      "tests/dma/",
      "config/");

   for Object_Dir use "obj/" & Psxada_Config.Build_Profile;

   for Create_Missing_Dirs use "True";

   for Exec_Dir use "bin";

   for Main use ("psxada.adb");

   -- 🌟 CORREGIDO: Todo lo relacionado a la compilación encapsulado aquí dentro
   package Compiler is
      for Default_Switches ("Ada") use Psxada_Config.Ada_Compiler_Switches;
      
      -- Obligamos a usar clang nativo de macOS para la arquitectura ARM64 de tu M2
      for Driver ("C")             use "clang";
      for Default_Switches ("C")   use ("-O2", "-x", "objective-c");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      -- Enlazamos las librerías nativas de tu Mac M2
      for Default_Switches ("Ada") use ("-framework", "AppKit", "-framework", "Metal", "-framework", "QuartzCore");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

   package Naming is
      for Body_Suffix ("C") use ".m"; -- Obliga a gprbuild a compilar los archivos .m con clang
   end Naming;

end Psxada;
