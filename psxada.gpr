with "config/psxada_config.gpr";

project Psxada is

   for Source_Dirs use
     ("src/psx/",
      "src/types/",
      "src/psxada/",
      "src/cpu/",
      "src/cpu/register/",
      "src/cpu/cycles/",
      "src/cpu/muldiv/",
      "src/cpu/instruction/",
      "src/cpu/execute/",
      "src/cpu/fetch",
      "src/cpu/muldiv",
      "src/cpu/step",
      "src/gpu/",
      "src/gte/",
      "src/gte/instruction/",
      "src/gte/execute/",
      "src/spu/",
      "src/memory/",
      "src/state/",
      "src/dma/",
      "src/timers/",
      "bios/",
      "tests/cpu/execute",
      "tests/cpu/register",
      "tests/cpu/muldiv",
      "tests/cpu/step",
      "tests/memory/",
      "tests/bios/",
      "tests/spu/",
      "tests/timers/",
      "tests/gpu/",
      "tests/dma/",
      "config/");

   for Object_Dir use "obj/" & Psxada_Config.Build_Profile;

   for Create_Missing_Dirs use "True";

   for Exec_Dir use "bin";

   for Main use ("psxada.adb");

   package Compiler is
      for Default_Switches ("Ada")
      use Psxada_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Psxada;