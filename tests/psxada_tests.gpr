project Psxada_Tests extends "../psxada.gpr" is

   for Source_Dirs use
     ("cpu/execute/",
      "cpu/muldiv/",
      "memory/",
      "spu/",
      "gpu/",
      "gte/",
      "timers/",
      "dma/",
      "bios/");

   for Object_Dir use "obj";

   for Exec_Dir use "bin";

   for Main use
     ("psx_cpu_execute_tests.adb",
      "psx_cpu_load_delay_tests.adb",
      "psx_cpu_load_use_delay_tests.adb",
      "psx_cpu_muldiv_tests.adb",
      "psx_cpu_muldiv_stall_tests.adb",
      "psx_cpu_lb_delay_tests.adb",
      "psx_cpu_lbu_delay_tests.adb",
      "psx_cpu_halfword_delay_tests.adb",
      "psx_cpu_lwl_delay_tests.adb",
      "psx_cpu_lwr_delay_tests.adb",
      "psx_cpu_lwl_lwr_delay_tests.adb",
      "psx_cpu_store_tests.adb",
      "psx_cpu_swl_swr_tests.adb",
      "psx_cpu_logic_tests.adb",
      "psx_cpu_logic_immediate_tests.adb",
      "psx_cpu_compare_immediate_tests.adb",
      "psx_cpu_shift_tests.adb",
      "psx_cpu_compare_tests.adb",
      "psx_cpu_hilo_move_tests.adb",
      "psx_cpu_add_sub_unsigned_tests.adb",
      "psx_cpu_add_immediate_tests.adb",
      "psx_cpu_lui_tests.adb",
      "psx_cpu_regimm_branch_tests.adb",
      "psx_cpu_regimm_link_branch_tests.adb",
      "psx_cpu_cop0_mfc0_tests.adb",
      "psx_memory_tests.adb",
      "psx_memory_cycles_tests.adb",
      "psx_memory_store_cycle_tests.adb",
      "psx_memory_load_timing_tests.adb",
      "psx_memory_load_cycle_count_tests.adb",
      "psx_memory_load_all_cycle_tests.adb",
      "psx_memory_unaligned_tests.adb",
      "psx_cpu_step_tests.adb",
      "psx_spu_tests.adb",
      "psx_gpu_tests.adb",
      "psx_dma_register_tests.adb",
      "psx_dma_otc_tests.adb",
      "psx_dma_gpu_tests.adb",
      "psx_timers_tests.adb",
      "psx_bios_tests.adb");

end Psxada_Tests;